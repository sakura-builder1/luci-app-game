			},
			"ubus": {
				"uci": [ "set", "add", "delete", "commit", "apply", "confirm", "rollback", "save", "revert", "changes" ],
				"luci.sakura_game": [ "games", "status", "storage", "names", "favs", "cheat_get", "cheat_set",
					"name_set", "fav_toggle", "save", "rm", "remount", "assets_fetch", "assets_status" ]
			}
