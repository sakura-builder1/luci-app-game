#!/bin/sh
# 游戏站数据接口：把 ubus 调用包装成简单 HTTP 接口
. /usr/share/libubox/jshn.sh 2>/dev/null

CFG=game
hdr() { printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'; }
GAME_DIR=$(uci -q get $CFG.main.game_dir); [ -n "$GAME_DIR" ] || GAME_DIR=/opt/game
GAME_DIR=${GAME_DIR%/}
SAVE_DIR="$GAME_DIR/saves"
RECENT="$GAME_DIR/recent.map"

q=$QUERY_STRING
getq() { printf '%s' "$q" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }
urldec() { printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')" 2>/dev/null || printf '%s' "$1"; }

m=$(getq m)

ub() {   # ub <方法> <json参数>
	if [ -n "$2" ]; then ubus call luci.sakura_game "$1" "$2" 2>/dev/null
	else ubus call luci.sakura_game "$1" '{}' 2>/dev/null; fi
}

jesc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

case "$m" in
	games)   hdr; ub games ;;
	names)   hdr; ub names ;;
	favs)    hdr; ub favs ;;
	storage) hdr; ub storage ;;
	status)  hdr; ub status ;;

	fav_toggle)
		p=$(urldec "$(getq p)")
		case "$p" in ""|/*|*..*) hdr; json_init; json_add_boolean ok 0; json_add_string msg "非法路径"; json_dump; exit 0 ;; esac
		hdr; ub fav_toggle "{\"path\":\"$(jesc "$p")\"}"
		;;
	name_set)
		p=$(urldec "$(getq p)"); d=$(urldec "$(getq d)")
		case "$p" in ""|/*|*..*) hdr; json_init; json_add_boolean ok 0; json_add_string msg "非法路径"; json_dump; exit 0 ;; esac
		hdr; ub name_set "{\"path\":\"$(jesc "$p")\",\"display\":\"$(jesc "$d")\"}"
		;;
	rm)
		p=$(urldec "$(getq p)")
		case "$p" in ""|/*|*..*) hdr; json_init; json_add_boolean ok 0; json_add_string msg "非法路径"; json_dump; exit 0 ;; esac
		hdr; ub rm "{\"path\":\"$(jesc "$p")\"}"
		;;
	cheat_get)
		p=$(urldec "$(getq p)")
		case "$p" in ""|/*|*..*) hdr; json_init; json_add_boolean ok 0; json_add_string msg "非法路径"; json_dump; exit 0 ;; esac
		hdr; ub cheat_get "{\"path\":\"$(jesc "$p")\"}"
		;;
	cheat_set)
		p=$(urldec "$(getq p)")
		case "$p" in ""|/*|*..*) hdr; json_init; json_add_boolean ok 0; json_add_string msg "非法路径"; json_dump; exit 0 ;; esac
		body=$(cat)
		hdr; ub cheat_set "{\"path\":\"$(jesc "$p")\",\"text\":\"$(jesc "$body")\"}"
		;;
	key_check)
		hdr; json_init; json_add_boolean ok 1; json_add_boolean valid "$([ -z "$KEY" ] || [ "$k" = "$KEY" ] && echo 1 || echo 0)"; json_dump
		;;

	state_put)
		p=$(urldec "$(getq p)"); slot=$(getq slot)
		case "$p" in ""|/*|*..*) hdr; json_init; json_add_boolean ok 0; json_add_string msg "非法路径"; json_dump; exit 0 ;; esac
		case "$slot" in ""|*[!0-9]*) slot=1 ;; esac
		SD="$SAVE_DIR"; mkdir -p "$SD"
		sf=$(printf '%s' "$p" | sed 's#/#__#g')
		cat > "$SD/$sf.slot$slot.state"
		sz=$(wc -c < "$SD/$sf.slot$slot.state" 2>/dev/null || echo 0)
		hdr; json_init; json_add_boolean ok 1; json_add_int size "$sz"; json_add_string msg "已存档（槽 $slot · ${sz} 字节）"; json_dump
		;;
	state_get)
		p=$(urldec "$(getq p)"); slot=$(getq slot)
		case "$p" in ""|/*|*..*) printf 'Content-Type: application/json\r\n\r\n{"ok":false}\n'; exit 0 ;; esac
		case "$slot" in ""|*[!0-9]*) slot=1 ;; esac
		sf=$(printf '%s' "$p" | sed 's#/#__#g')
		sf="$SAVE_DIR/$sf.slot$slot.state"
		if [ -f "$sf" ]; then
			printf 'Content-Type: application/octet-stream\r\nCache-Control: no-store\r\nContent-Length: %s\r\n\r\n' "$(wc -c < "$sf")"
			cat "$sf"
		else
			printf 'Content-Type: application/json\r\n\r\n{"ok":false,"msg":"没有存档"}\n'
		fi
		exit 0
		;;
	state_list)
		p=$(urldec "$(getq p)")
		sf=$(printf '%s' "$p" | sed 's#/#__#g')
		hdr; json_init; json_add_array states
		for n in 1 2 3 4 5; do
			f2="$SAVE_DIR/$sf.slot$n.state"
			if [ -f "$f2" ]; then
				json_add_object
				json_add_int slot "$n"
				json_add_int size "$(wc -c < "$f2")"
				json_add_int mtime "$(stat -c %Y "$f2" 2>/dev/null || echo 0)"
				json_close_object
			fi
		done
		json_close_array; json_dump
		;;
	state_del)
		p=$(urldec "$(getq p)"); slot=$(getq slot)
		case "$slot" in ""|*[!0-9]*) slot=1 ;; esac
		sf=$(printf '%s' "$p" | sed 's#/#__#g')
		rm -f "$SAVE_DIR/$sf.slot$slot.state"
		hdr; json_init; json_add_boolean ok 1; json_dump
		;;
	play)   # 记录最近游玩（写 playlog）
		p=$(urldec "$(getq p)")
		n=$(urldec "$(getq n)")
		case "$p" in ""|/*|*..*) exit 0 ;; esac
		f="$RECENT"
		t=$(date +%s)
		awk -F'\t' -v k="$p" '$1 != k' "$f" > "$f.tmp" 2>/dev/null || : > "$f.tmp"
		printf '%s\t%s\t%s\n' "$p" "$n" "$t" >> "$f.tmp"
		tail -n 60 "$f.tmp" > "$f" 2>/dev/null
		rm -f "$f.tmp"
		hdr; json_init; json_add_boolean ok 1; json_dump
		;;
	recent)
		f="$RECENT"
		hdr; json_init; json_add_array recent
		if [ -f "$f" ]; then
			_oi="$IFS"; IFS='
'
			for line in $(cat "$f" 2>/dev/null); do
				json_add_object
				json_add_string path "${line%%	*}"; _r=${line#*	}
				json_add_string name "${_r%%	*}"
				json_add_int at "${_r##*	}"
				json_close_object
			done
			IFS="$_oi"
		fi
		json_close_array; json_dump
		;;
	*)
		hdr; json_init; json_add_boolean ok 0; json_add_string msg "未知方法：$m"; json_dump
		;;
esac
echo
exit 0
